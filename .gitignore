# Private FPGA implementation, generated hardware and debug exports.
/fpga/
/hardware/

# Retain unused legacy drivers locally; publish the active capture driver.
/firmware/board/e200/linux/*/
!/firmware/board/e200/linux/fpv_capture/
/firmware/board/e200/linux/fpv_capture/*
!/firmware/board/e200/linux/fpv_capture/Kconfig
!/firmware/board/e200/linux/fpv_capture/Makefile
!/firmware/board/e200/linux/fpv_capture/fpv_capture.c
!/firmware/board/e200/linux/fpv_capture/fpv_spectrum.c
!/firmware/board/e200/linux/fpv_capture/COPYING
/firmware/board/e200/patches/autosave/

# Independent upstream checkouts and local build/deployment outputs.
/firmware/u-boot/
/firmware/linux/
/firmware/buildroot/
/firmware/embeddedsw/
/firmware/device-tree-xlnx/
/firmware/build/
/firmware/.source-stamps/
/firmware/.fetch.lock
/build/
/fpv-recordings/
/.vscode/
.Xil/
/*.gen/
/NA/
__pycache__/
*.pyc

# Captured signals and local device data.
/*.packet
/*.pgm
/*.bmp

# Internal designs, implementation plans, manifests and lab records.
/docs/*

# Verification sources that expose/depend on private implementation.
/tests/test_fpga_export.py
/tests/test_e200_ethernet.py
/tests/check_capture_packets.py

# SD boot archives are retained locally for GitHub Release attachments.
/images/
