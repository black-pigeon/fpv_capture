/ {
	model = "ANTSDR E200";
	compatible = "microphase,antsdr-e200", "xlnx,zynq-7000";

	chosen {
		bootargs = "console=ttyPS0,115200 earlycon=cdns,mmio,0xe0000000 root=/dev/ram rw mem=256M cma=128M";
		stdout-path = "serial0:115200n8";
	};

	aliases {
		ethernet0 = &gem0;
		serial0 = &uart0;
		serial1 = &uart1;
		mmc0 = &sdhci0;
		spi0 = &spi0;
		spi1 = &qspi;
		i2c0 = &i2c0;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x10000000>;
	};
};

&sdhci0 {
	status = "okay";
	disable-wp;
};

&uart0 {
	status = "okay";
};

&spi0 {
	status = "okay";
	num-cs = <1>;
	is-decoded-cs = <0>;

	ad9361_spi: ad9361@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <20000000>;
	};
};

&qspi {
	status = "okay";
	is-dual = <0>;
	num-cs = <1>;

	flash@0 {
		compatible = "winbond,w25q256", "jedec,spi-nor";
		reg = <0x0>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <4>;
		spi-max-frequency = <50000000>;
		#address-cells = <1>;
		#size-cells = <1>;

		partition@1fe0000 {
			label = "uoe-netcfg";
			reg = <0x01fe0000 0x00010000>;
		};
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <400000>;

	eeprom@50 {
		compatible = "atmel,24c256";
		reg = <0x50>;
	};
};

&gpio0 {
	status = "okay";
};

&clkc {
	fclk-enable = <0xf>;
};

// PS GEM0 -> EMIO GMII -> PL GMII/RGMII bridge -> RTL8211F.
// Match the verified antsdr-fw-patch E200 PHY mode and bridge parameters.
// B19 PHY reset stays high in the FPGA shell. Read the PHY ID over MDIO:
// forcing a PHY ID creates a device even if the hardware does not respond.
&gem0 {
    status = "okay";
    phy-mode = "rgmii-rxid";
    phy-handle = <&rtl8211f_phy>;
    local-mac-address = [00 0a 35 00 00 00];
    #address-cells = <1>;
    #size-cells = <0>;

    // Merge into the MDIO bus generated from the XSA. Reuse its converter
    // node instead of declaring another node/label at the same address.
    mdio {
        #address-cells = <1>;
        #size-cells = <0>;
        rtl8211f_phy: ethernet-phy@1 {
            compatible = "ethernet-phy-ieee802.3-c22";
            reg = <1>;
        };
    };
};

&gmii_to_rgmii_0 {
    phy-handle = <&rtl8211f_phy>;
};

// Shared capture control is implemented in top-level RTL, outside the BD.
/ {
    fpv_capture: fpv-capture@43c30000 {
        compatible = "fpv,e200-capture-1.0";
        reg = <0x43c30000 0x10000>;
        dmas = <&fpv_dma 1>; // Xilinx DMA channel 1 = S2MM
        dma-names = "rx";
        status = "okay";
    };
};
