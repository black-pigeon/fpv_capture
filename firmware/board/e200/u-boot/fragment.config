CONFIG_USE_BOOTCOMMAND=y
CONFIG_DEFAULT_DEVICE_TREE="zynq-e200"
CONFIG_DEBUG_UART_BASE=0xe0000000
CONFIG_DEBUG_UART_CLOCK=50000000
CONFIG_CMD_FPGA=y
CONFIG_CMD_FPGA_LOADBP=y
CONFIG_CMD_LOADB=y
CONFIG_FPGA=y
CONFIG_FPGA_XILINX=y
CONFIG_FPGA_ZYNQPL=y
CONFIG_CMD_BOOTZ=y
CONFIG_BOOTDELAY=1
CONFIG_BOOTCOMMAND="if mmc dev 0; then if fatload mmc 0:1 0x03000000 uEnv.txt; then if env import -t 0x03000000 ${filesize}; then if env exists uenvcmd; then run uenvcmd; fi; fi; fi; fi"
CONFIG_PARTITIONS=y
CONFIG_DOS_PARTITION=y
CONFIG_CMD_FAT=y
CONFIG_CMD_FS_GENERIC=y
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_NAND is not set
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
CONFIG_ENV_IS_NOWHERE=y
