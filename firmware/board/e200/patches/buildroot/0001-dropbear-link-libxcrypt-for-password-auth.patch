From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Wed, 1 Jul 2026 18:20:00 +0800
Subject: [PATCH] dropbear: link libxcrypt for password authentication

When libxcrypt is selected, make Dropbear depend on it and pass
`-lcrypt` during configure. Without this, Dropbear can be configured
before libcrypt is available in the staging sysroot, causing
DROPBEAR_SVR_PASSWORD_AUTH to be compiled out.

---
 package/dropbear/dropbear.mk | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/package/dropbear/dropbear.mk b/package/dropbear/dropbear.mk
index 98d8d0622d..0853f81d5e 100644
--- a/package/dropbear/dropbear.mk
+++ b/package/dropbear/dropbear.mk
@@ -30,6 +30,11 @@ DROPBEAR_MAKE = \
 	$(MAKE) MULTI=1 SCPPROGRESS=1 \
 	PROGRAMS="$(DROPBEAR_PROGRAMS)"
 
+ifeq ($(BR2_PACKAGE_LIBXCRYPT),y)
+DROPBEAR_DEPENDENCIES += libxcrypt
+DROPBEAR_CONF_ENV += LIBS="-lcrypt"
+endif
+
 # With BR2_SHARED_STATIC_LIBS=y the generic infrastructure adds a
 # --enable-static flags causing dropbear to be built as a static
 # binary. Adding a --disable-static reverts this
-- 
2.34.1
